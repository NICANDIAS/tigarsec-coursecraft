# Copy this file to .env and fill in your values. Never commit the real .env file.

# Which LLM provider to use: "anthropic" (hosted, costs money after a small free trial
# credit, best quality) or "ollama" (runs a free open-source model on your own machine,
# no account/key/payment needed - good for testing everything at zero cost first).
LLM_PROVIDER=ollama

# --- Only needed if LLM_PROVIDER=anthropic ---
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Check https://docs.claude.com for the current recommended model string.
TIGARSEC_LLM_MODEL=claude-sonnet-5

# --- Only needed if LLM_PROVIDER=ollama ---
# Install Ollama from https://ollama.com, run `ollama serve`, then `ollama pull llama3.1:8b`
# (or another model of your choice) before starting TIGARSEC Assess.
# If TIGARSEC Assess is running in Docker and Ollama is on your host machine (not in Docker),
# use http://host.docker.internal:11434 instead of localhost.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# How much memory/CPU the Ollama container is allowed to use - tune this to whatever
# model you actually run (a bigger model needs more headroom) and to your machine's real
# capacity. On macOS, Docker Desktop's OWN memory allocation (Settings -> Resources ->
# Memory) caps the WHOLE Docker VM shared across every container - raising these two
# values does nothing if that setting is smaller than what you're asking for here.
OLLAMA_MEM_LIMIT=6g
OLLAMA_CPUS=4

# Required in any real deployment - used to sign login session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# --- Only needed for two-factor login (emailed one-time codes) ---
# Without these set, 2FA cannot be turned on for any account (blocked at the point of
# enabling it - see Settings/Admin: System Settings), and mandatory 2FA cannot be turned
# on system-wide either, so nothing breaks if you leave this section blank/unset.
# Ask your IT/email admin which mail relay to use - any standard SMTP server works,
# no specific vendor required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
# Set to "false" only if your mail relay does not use STARTTLS (uncommon).
SMTP_USE_TLS=true

# Optional - defaults to a local SQLite file if not set.
DATABASE_URL=sqlite:///./data/tigarsec_assess.db

# --- Running where strangers can reach it (e.g. a public demo over the internet) ---
# closed = only the admin creates accounts (Admin -> Users). The first account can always register.
REGISTRATION=open
# true = login cookies only travel over HTTPS. Only set this when the site is served over HTTPS.
COOKIE_SECURE=false
# Failed logins allowed per email before a pause, and how long the pause lasts.
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
# Leave empty on a LAN. Set to * ONLY when a proxy on the same machine is the only way in
# (the app port bound to 127.0.0.1), so visitors' real addresses reach the login protection.
FORWARDED_ALLOW_IPS=

# Who colleges are told to contact to renew their CourseCraft licence (shown in the notices).
LICENCE_CONTACT=support@tigarsec.com
